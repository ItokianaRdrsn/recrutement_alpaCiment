# Configuration n8n
N8N_PORT=5678
GENERIC_TIMEZONE=Indian/Antananarivo

# Configuration Webhook & URL
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

# Sécurité & Permissions
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# URLs des services appelés par les workflows n8n (vus DEPUIS le conteneur n8n)
# - Même machine (Docker Desktop / Linux avec host-gateway) : host.docker.internal
# - Serveur distinct : mettre l'IP ou le nom DNS, ex. http://192.168.1.20:8001
OCR_BASE_URL=http://host.docker.internal:8001
LARAVEL_BASE_URL=http://host.docker.internal:8000
