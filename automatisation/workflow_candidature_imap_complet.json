    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst item = items[0];\nconst binary = item.binary || {};\nconst binaryKeys = Object.keys(binary);\n\nif (binaryKeys.length === 0) {\n  throw new Error('Aucune piece jointe trouvee');\n}\n\nconst validExtensions = ['pdf', 'doc', 'docx', 'png', 'jpg', 'jpeg', 'tiff'];\nlet cvKey = null;\n\nfor (const key of binaryKeys) {\n  const filename = (binary[key].fileName || '').toLowerCase();\n  const isValid = validExtensions.some(ext => filename.endsWith('.' + ext));\n  if (isValid) {\n    cvKey = key;\n    break;\n  }\n}\n\nif (!cvKey) {\n  throw new Error('Aucun fichier CV valide parmi: ' + binaryKeys.map(k => binary[k].fileName).join(', '));\n}\n\nreturn [{\n  json: {\n    cv_filename: binary[cvKey].fileName,\n    cv_mimetype: binary[cvKey].mimeType\n  },\n  binary: {\n    data: binary[cvKey]\n  }\n}];"
      },
      "id": "093f3c9f-4fb4-40fc-9db0-68fe5a413219",
      "name": "6. Filtrer Binaire CV1",
      "type": "n8n-nodes-base.code",
